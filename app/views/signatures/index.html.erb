<%= content_for :page_title do %>Signatures - Sustainable software manifesto<% end %>
<%= content_for :page_description do %>View all signatories of the sustainable software manifesto - individuals and organizations committed to sustainable software development.<% end %>

<div class="px-6 py-16 lg:px-8">
  <div class="mx-auto max-w-3xl text-base/7">
    <h1 class="mt-2 text-pretty text-4xl font-semibold tracking-tight text-gray-900 dark:text-gray-100 sm:text-5xl">Signatures</h1>
    <p class="mt-6 text-xl/8 text-gray-700 dark:text-gray-400">
      Thank you to everyone who has signed the sustainable software manifesto. Together, we're building a more sustainable future for software development.
    </p>

    <div class="mt-10 flex gap-x-8">
      <div>
        <p class="text-sm text-gray-600 dark:text-gray-400">Individuals</p>
        <p class="text-3xl font-semibold text-gray-900 dark:text-gray-100"><%= @individual_count %></p>
      </div>
      <div>
        <p class="text-sm text-gray-600 dark:text-gray-400">Organizations</p>
        <p class="text-3xl font-semibold text-gray-900 dark:text-gray-100"><%= @organization_count %></p>
      </div>
    </div>

    <%# Each page lives in its own frame; "Load more" fills the next page's frame with that page's records and link %>
    <%= turbo_frame_tag "signatures_page_#{@pagy.page}", class: "mt-12 block space-y-4" do %>
      <%= render @signatures %>

      <% if @pagy.next %>
        <%= turbo_frame_tag "signatures_page_#{@pagy.next}", class: "block space-y-4" do %>
          <div class="pt-2 text-center" data-controller="infinite-scroll">
            <%= link_to "Load more", signatures_path(page: @pagy.next), class: "pagy-nav", data: { turbo_frame: "signatures_page_#{@pagy.next}", turbo_action: "advance" }, rel: "next" %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
